{
  "name": "pdf-studio-windows",
  "version": "3.0.2",
  "private": true,
  "description": "PDF Studio — a modern, local-first Windows PDF workspace built with Electron, React, Node.js and Tailwind CSS.",
  "author": "Jessie Albert Regualos",
  "license": "UNLICENSED",
  "main": "electron/main.cjs",
  "scripts": {
    "postinstall": "npm run prepare:pdfjs-assets",
    "dev": "npm run prepare:pdfjs-assets && concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "start": "npm run web:build && electron .",
    "web:dev": "npm run prepare:pdfjs-assets && vite --host 127.0.0.1",
    "web:build": "npm run prepare:pdfjs-assets && vite build",
    "build": "npm run build:win",
    "prebuild:win": "node scripts/release-tool.cjs clean",
    "build:win": "npm run web:build && electron-builder --win portable --x64",
    "postbuild:win": "node scripts/release-tool.cjs finalize",
    "check": "npm run web:build",
    "test:access": "node scripts/test-access-policy.cjs && node scripts/test-monitor-telemetry.cjs",
    "prepare:pdfjs-assets": "node scripts/copy-pdfjs-assets.cjs"
  },
  "dependencies": {
    "mammoth": "^1.13.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "docx": "^9.14.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "lucide-react": "^1.61.0",
    "motion": "13.5.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "postcss": "^8.5.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^3.4.19",
    "vite": "^8.3.5",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.regualos.pdfstudio",
    "productName": "PDF Studio",
    "directories": {
      "output": "publish"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!**/*.map"
    ],
    "asar": true,
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icons/pdf-studio.ico",
      "executableName": "PdfStudio",
      "artifactName": "PdfStudio.exe",
      "requestedExecutionLevel": "asInvoker"
    },
    "portable": {
      "artifactName": "PdfStudio.exe"
    },
    "extraResources": [
      {
        "from": "public/icons",
        "to": "icons",
        "filter": [
          "pdf-studio.ico"
        ]
      }
    ]
  },
  "type": "module"
}
