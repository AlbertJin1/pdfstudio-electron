{
  "name": "pdf-studio-cross-platform",
  "version": "3.0.0",
  "private": true,
  "description": "PDF Studio — a modern, local-first cross-platform PDF workspace built with Electron, React, Node.js and Tailwind CSS.",
  "author": "Jessie Albert Regualos",
  "license": "UNLICENSED",
  "main": "electron/main.cjs",
  "scripts": {
    "postinstall": "node scripts/copy-pdfjs-assets.cjs",
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "start": "electron .",
    "web:dev": "vite --host 127.0.0.1",
    "web:build": "vite build",
    "build": "vite build && electron-builder",
    "build:win": "vite build && electron-builder --win portable",
    "build:mac": "vite build && electron-builder --mac zip",
    "build:linux": "vite build && electron-builder --linux AppImage",
    "build:dir": "vite build && electron-builder --dir",
    "check": "vite build",
    "build:mac:x64": "vite build && electron-builder --mac zip --x64",
    "build:mac:arm64": "vite build && electron-builder --mac zip --arm64",
    "build:linux:x64": "vite build && electron-builder --linux AppImage --x64",
    "build:linux:arm64": "vite build && electron-builder --linux AppImage --arm64"
  },
  "dependencies": {
    "docx": "^9.14.0",
    "lucide-react": "^1.61.0",
    "mammoth": "^1.13.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "vite": "^8.3.5",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.regualos.pdfstudio",
    "productName": "PDF Studio",
    "artifactName": "PDF-Studio-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!legacy-windows/**/*",
      "!**/*.map"
    ],
    "asar": true,
    "npmRebuild": true,
    "win": {
      "target": [
        "portable"
      ],
      "icon": "legacy-windows/assets/pdf-studio.ico",
      "executableName": "PdfStudio",
      "artifactName": "PDF-Studio-${version}-Portable-${arch}.${ext}",
      "requestedExecutionLevel": "asInvoker"
    },
    "mac": {
      "target": [
        "zip"
      ],
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "maintainer": "Jessie Albert Regualos"
    },
    "portable": {
      "artifactName": "PDF-Studio-${version}-Portable-${arch}.${ext}"
    }
  },
  "type": "module"
}
