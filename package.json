{
  "name": "pdf-studio-windows",
  "version": "3.0.9",
  "private": true,
  "description": "PDF Studio — a modern, local-first Windows PDF workspace built with Electron, React, Node.js and Tailwind CSS.",
  "author": "Jessie Albert Regualos",
  "license": "UNLICENSED",
  "main": "electron/main.cjs",
  "scripts": {
    "postinstall": "npm run prepare:pdfjs-assets",
    "dev": "npm run prepare:pdfjs-assets && concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "start": "npm run web:build && electron .",
    "start:fast": "npm run web:build && electron .",
    "web:dev": "npm run prepare:pdfjs-assets && vite --host 127.0.0.1",
    "web:build": "npm run prepare:pdfjs-assets && vite build",
    "build": "npm run build:win",
    "prebuild:win": "node scripts/check-no-real-env.cjs && node scripts/release-tool.cjs clean && node scripts/prepare-bundled-resources.cjs",
    "build:win": "npm run web:build && electron-builder --win portable --x64",
    "postbuild:win": "node scripts/release-tool.cjs finalize",
    "check": "npm run web:build",
    "test:access": "node tests/access-policy.test.cjs && node tests/monitor-telemetry.test.cjs && node tests/review-queue-policy.test.cjs",
    "prepare:pdfjs-assets": "node scripts/copy-pdfjs-assets.cjs",
    "test:pdf": "node tests/ghostscript-compression.test.cjs && node tests/pdf-compression.test.mjs && node tests/pdf-word-policy.test.cjs && node tests/ocr-service.test.cjs && node tests/image-text-extractor.test.cjs && node tests/emoji-merge.test.mjs && node --experimental-default-type=module tests/pdf-word-layout.test.mjs && node tests/pdf-to-docx-e2e.test.mjs",
    "test:branding": "node tests/branding-ui.test.cjs",
    "test:theme-ux": "node tests/theme-ux.test.cjs",
    "test:workspace-ui": "node tests/workspace-ui.test.cjs",
    "test:photo-editor": "node --test tests/photo-editor.test.mjs",
    "test:update": "node tests/portable-update-engine.test.cjs && node tests/old-version-cleanup.test.cjs",
    "test:release-script": "node tests/release-script.test.cjs",
    "test:build-size": "node tests/build-size-policy.test.cjs"
  },
  "dependencies": {
    "@jspawn/ghostscript-wasm": "0.0.2",
    "@tesseract.js-data/ceb": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/fil": "^1.0.0",
    "compress-pdf-lib": "^1.0.5",
    "jszip": "^3.10.2",
    "libheif-js": "^1.23.5",
    "mammoth": "^1.13.0",
    "pdfstudio": "0.4.0",
    "tesseract.js": "^5.1.1",
    "utif": "^3.1.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "docx": "^9.14.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "lucide-react": "^1.61.0",
    "motion": "13.5.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "postcss": "^8.5.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^3.4.19",
    "vite": "^8.3.5",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.regualos.pdfstudio",
    "productName": "PDF Studio",
    "directories": {
      "output": "publish"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!**/.env",
      "!**/.env.*",
      "!**/*.map",
      "!**/*.md",
      "!**/*.d.ts",
      "!**/{test,tests,__tests__,docs,example,examples}/**",
      "!**/*.pdb",
      "!**/*.ilk",
      "!**/*.tsbuildinfo",
      "!**/coverage/**",
      "!**/.git/**",
      "!**/.github/**",
      "!**/.vscode/**"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/@jspawn/ghostscript-wasm/**",
      "node_modules/{tesseract.js,tesseract.js-core,wasm-feature-detect,regenerator-runtime,is-url,is-electron,bmp-js,idb-keyval,node-fetch,whatwg-url,tr46,webidl-conversions,zlibjs,opencollective-postinstall}/**",
      "node_modules/@tesseract.js-data/**",
      "electron/services/ghostscript-wasm-worker.cjs"
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icons/pdf-studio.ico",
      "executableName": "PdfStudio",
      "artifactName": "PdfStudio.exe",
      "requestedExecutionLevel": "asInvoker",
      "compression": "maximum",
      "electronLanguages": [
        "en-US"
      ],
      "legalTrademarks": "PDF Studio"
    },
    "portable": {
      "artifactName": "PdfStudio.exe"
    },
    "extraResources": [
      {
        "from": "public/icons",
        "to": "icons",
        "filter": [
          "pdf-studio.ico"
        ]
      },
      {
        "from": "build-resources/ocr",
        "to": "ocr",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "build-resources/ghostscript",
        "to": "ghostscript",
        "filter": [
          "**/*"
        ]
      }
    ],
    "copyright": "Copyright © Jessie Albert Regualos",
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true,
      "enableCookieEncryption": true
    }
  },
  "type": "module"
}
