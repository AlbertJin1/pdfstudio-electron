<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>PdfStudio</RootNamespace>
    <AssemblyName>PdfStudio</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets\pdf-studio.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- pdfium.dll and libSkiaSharp.dll are bundled INSIDE PdfStudio.exe and unpacked by the .NET host on first start, so the single exe works on its own (and the in-app updater, which replaces only the exe, can never leave it without them). Bundle compression stays off because compressed bundles look like packers to heuristic scanners. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <AssemblyTitle>PDF Studio</AssemblyTitle>
    <Product>PDF Studio</Product>
    <Description>PDF Studio — merge, reorder, edit, convert and export PDF pages.</Description>
    <Company>Jessie Albert Regualos</Company>
    <Authors>Jessie Albert Regualos</Authors>
    <Version>2.8.15</Version>
    <FileVersion>2.8.15.0</FileVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
      <Copyright>© Jessie Albert Regualos</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <PackageReference Include="PDFtoImage" Version="5.4.0" />
    <PackageReference Include="TesseractOCR" Version="5.5.2" />
  </ItemGroup>
  <ItemGroup>
    <None Include="assets\pdf-studio.ico" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="assets\ocr\tessdata\eng.traineddata" LogicalName="PdfStudio.Ocr.tessdata.eng.traineddata" />
    <None Include="assets\ocr\TESSERACT-ENG-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="assets\ocr\APACHE-2.0.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Release guard: the version being built must be documented in CHANGELOG.md and in Services/ChangeLog.cs (the in-app version history). -->
  <Target Name="CheckChangelog" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <_ChangelogMd>$(MSBuildProjectDirectory)/CHANGELOG.md</_ChangelogMd>
      <_ChangelogCs>$(MSBuildProjectDirectory)/Services/ChangeLog.cs</_ChangelogCs>
      <_ChangelogMdText Condition="Exists('$(_ChangelogMd)')">$([System.IO.File]::ReadAllText('$(_ChangelogMd)'))</_ChangelogMdText>
      <_ChangelogCsText Condition="Exists('$(_ChangelogCs)')">$([System.IO.File]::ReadAllText('$(_ChangelogCs)'))</_ChangelogCsText>
    </PropertyGroup>
    <Error Condition="!$(_ChangelogMdText.Contains('## [$(Version)] - '))"
           Text="CHANGELOG.md has no entry for version $(Version). Add a '## [$(Version)] - YYYY-MM-DD' section before building a release." />
    <Error Condition="!$(_ChangelogCsText.Contains('&quot;$(Version)&quot;, new DateOnly'))"
           Text="Services/ChangeLog.cs has no entry for version $(Version). Add it at the top of ChangeLog.Releases so the in-app version history matches CHANGELOG.md." />
  </Target>
</Project>
